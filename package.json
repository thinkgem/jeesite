{
  "name": "@jeesite/root",
  "version": "5.19.0",
  "type": "module",
  "private": true,
  "scripts": {
    "bootstrap": "pnpm install",
    "dev": "cd web && pnpm run dev",
    "build": "turbo build --concurrency 20",
    "build:tomcat": "cd web && pnpm build:tomcat",
    "build:preview": "pnpm run preview",
    "report": "cd web && pnpm report",
    "preview": "cd web && pnpm preview",
    "preview:dist": "cd web && pnpm preview:dist",
    "type:check": "turbo type:check --concurrency 20",
    "lint:format": "oxlint --fix && oxfmt",
    "lint:all": "pnpm bootstrap && pnpm type:check && pnpm lint:format",
    "reinstall:force": "rimraf pnpm-lock.yaml node_modules && pnpm store prune && pnpm i --force && pnpm run dev --force",
    "reinstall": "turbo uninstall --concurrency 20 && rimraf pnpm-lock.yaml node_modules && pnpm bootstrap",
    "update:ncu": "turbo update --concurrency 20 && ncu -u -x typescript,monaco-editor && pnpm reinstall",
    "postinstall": "pnpm -r run stub --if-present",
    "preinstall": "npx only-allow pnpm",
    "serve": "pnpm dev"
  },
  "dependencies": {
    "@antdv-next/cssinjs": "1.0.6",
    "@antdv-next/icons": "1.1.1",
    "@jeesite/app": "workspace:*",
    "@jeesite/assets": "workspace:*",
    "@jeesite/cms": "workspace:*",
    "@jeesite/core": "workspace:*",
    "@jeesite/dbm": "workspace:*",
    "@jeesite/dfm": "workspace:*",
    "@jeesite/test": "workspace:*",
    "@jeesite/types": "workspace:*",
    "@jeesite/vite": "workspace:*",
    "@jeesite/web": "workspace:*",
    "antdv-next": "1.5.0",
    "axios": "1.19.0",
    "dayjs": "1.11.21",
    "lodash-es": "4.18.1",
    "vue": "3.5.41",
    "vue-router": "5.2.0",
    "vue-tsc": "3.3.9",
    "vue-types": "7.0.0"
  },
  "devDependencies": {
    "@antdv-next/unocss": "1.1.1",
    "@iconify/json": "2.2.514",
    "@iconify/utils": "3.1.4",
    "@types/node": "26.2.0",
    "@unocss/preset-wind3": "66.7.5",
    "@vue/compiler-sfc": "3.5.41",
    "@vue/runtime-core": "3.5.41",
    "@vue/runtime-dom": "3.5.41",
    "@vue/shared": "3.5.41",
    "autoprefixer": "10.5.4",
    "cross-env": "10.1.0",
    "globals": "17.10.0",
    "less": "4.8.1",
    "monaco-editor": "0.55.1",
    "npm-check-updates": "23.0.2",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "pkg-types": "2.3.1",
    "postcss": "8.5.26",
    "postcss-html": "2.0.0",
    "postcss-less": "6.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "3.0.2",
    "rimraf": "6.1.3",
    "turbo": "2.10.9",
    "typescript": "6.0.3",
    "unocss": "66.7.5",
    "vite": "8.2.1"
  },
  "keywords": [
    "typescript",
    "jeesite",
    "antdv",
    "vite",
    "vue"
  ],
  "resolutions": {
    "bin-wrapper": "npm:bin-wrapper-china"
  },
  "homepage": "https://jeesite.com",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/thinkgem/jeesite-vue.git"
  },
  "bugs": {
    "url": "https://gitee.com/thinkgem/jeesite-vue/issues"
  },
  "author": {
    "name": "ThinkGem",
    "email": "thinkgem@163.com",
    "url": "https://gitee.com/thinkgem"
  },
  "engines": {
    "node": ">=20.19 || >=22.12"
  },
  "packageManager": "pnpm@11.21.0"
}
